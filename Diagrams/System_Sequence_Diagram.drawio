  <diagram name="Page-1" id="5xupqIzZHKfrwzPqIfet">
    <mxGraphModel dx="1930" dy="2840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant User\n    participant Panel as Smart Panel ESP32-S3\n    participant Sensors as Environmental Sensors\n    participant Radar as RD-03D mmWave Radar\n    participant TB as ThingsBoard\n    participant Rule as ThingsBoard Rule Chain\n    participant Light as ESP32-S3 Light Device\n    participant SMTP as SMTP Email Service\n\n    User-&gt;&gt;Panel: Power on device\n    Panel-&gt;&gt;Sensors: Initialise I2C sensors\n    Panel-&gt;&gt;Radar: Initialise UART radar sensor\n    Panel-&gt;&gt;TB: Connect using Wi-Fi and MQTT\n\n    loop Periodic operation\n        Panel-&gt;&gt;Sensors: Read temperature, humidity, pressure, light and VOC\n        Sensors--&gt;&gt;Panel: Return sensor readings\n\n        Panel-&gt;&gt;Radar: Read presence state\n        Radar--&gt;&gt;Panel: Presence detected or not detected\n\n        Panel-&gt;&gt;TB: Publish telemetry using MQTT\n        Note over Panel,TB: Telemetry includes sensor values and presence state\n\n        TB-&gt;&gt;Rule: Process incoming telemetry\n\n        alt Presence detected\n            Rule-&gt;&gt;Light: Send RPC command: Light ON\n            Rule-&gt;&gt;SMTP: Send email alert\n        else No presence detected\n            Rule-&gt;&gt;Light: Send RPC command: Light OFF\n        end\n\n        alt Alarm mode enabled and presence detected\n            Panel-&gt;&gt;Panel: Trigger local buzzer alarm\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ta_GV_sIfnL3DBfN2uWz-1">
